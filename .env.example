APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
# Optional: required only by Apps Script receivers that validate a shared token
APPS_SCRIPT_TOKEN=replace-with-a-long-random-secret
PROJECT_REPOSITORY_URL=https://github.com/YOUR_USERNAME/elite-vault-powerplay-sheets-updater

# Optional tuning
VAULT_REQUEST_DELAY=1.5
VAULT_BATCH_SIZE=50
VAULT_MIN_BATCH_SIZE=10
VAULT_MAX_RETRIES=5
VAULT_TIMEOUT=60
MIN_EXCP_SYSTEMS=150
MIN_MATCH_SYSTEMS=1

# Optional destination sheet names
EXCP_SHEET=EXCP
MATCH_SHEET=EXCP_Mahon
